# Public configuration (safe for client bundle)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Server database (optional: falls back to local PostgreSQL 16 PGlite when unset)
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session & token secrets (generate strong random strings in production)
SESSION_SECRET=
TOKEN_HASH_PEPPER=

# Email delivery (Resend)
RESEND_API_KEY=
EMAIL_FROM=Hephzibah Media <desk@hephzibahmedia.com>

# Cloudinary signed uploads (server-only)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Cron authentication
CRON_SECRET=
